{
    "properties": {
        "steps": [
            {
                "name": "Step 1",
                "branches": [
                    {
                        "name": "Branch 1",
                        "actions": [
                            // VMs
                            {
                                "name": "urn:csci:microsoft:virtualMachine:shutdown/1.0",
                                "duration": "PT10M",
                                "parameters": [
                                    {
                                        "key": "abruptShutdown",
                                        "value": false
                                    }
                                ],
                                "selectorId": "VMsSelector",
                                "type": "continuous"
                            },
                            // Pause and wait for user
                            {
                                "name": "urn:csci:microsoft:chaosStudio:waitForInput/1.0",
                                "parameters": [
                                    {
                                        "key": "RequireResumeOnRestore",
                                        "value": false
                                    }
                                ],
                                "type": "delay"
                            },
                            // Redis Cache
                            {
                                "type": "discrete",
                                "name": "urn:csci:microsoft:azureClusteredCacheForRedis:reboot/1.0",
                                "parameters": [
                                    {
                                        "key": "RebootType",
                                        "value": "PrimaryNode"
                                    },
                                    {
                                        "key": "ShardId",
                                        "value": "0"
                                    }
                                ],
                                "selectorId": "RedisCache"
                            },
                            // Time Delay
                            {
                                "name": "urn:csci:microsoft:chaosStudio:timedDelay/1.0",
                                "duration": "PT10S",
                                "type": "delay"
                            },
                            // AKS
                            {
                                "name": "urn:csci:microsoft:AKS:shutdown/1.0",
                                "type": "continuous",
                                "selectorId": "AKSSelector",
                                "duration": "PT2M",
                                "parameters": [
                                    {
                                        "key": "abruptShutdown",
                                        "value": true
                                    },
                                    {
                                        "key": "disableAutoScale",
                                        "value": false
                                    }
                                ]
                            },
                            // PostgreSQL Flexible Servers
                            {
                                "name": "urn:csci:microsoft:DBforPostgreSQLFlexibleServers:failover/1.0",
                                "type": "continuous",
                                "selectorId": "PostgreSQLSelector",
                                "duration": "PT2M",
                                "parameters": [
                                    {
                                        "key": "ForcedFailover",
                                        "value": false
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ],
        "selectors": [
            {
                "id": "VMsSelector",
                "type": "List",
                "targets": [
                    {
                        "id": "/subscriptions/44194899-7181-423a-9dbc-278d99a7683a/resourceGroups/adcb-lab/providers/microsoft.compute/virtualMachines/dc",
                        "type": "ChaosTarget"
                    },
                    {
                        "id": "/subscriptions/44194899-7181-423a-9dbc-278d99a7683a/resourceGroups/ADCB-Lab/providers/Microsoft.Compute/virtualMachines/hyper-v",
                        "type": "ChaosTarget"
                    }
                ]
            },
            {
                "id": "PostgreSQLSelector",
                "type": "List",
                "targets": [
                    {
                        "type": "ChaosTarget",
                        "id": "/subscriptions/44194899-7181-423a-9dbc-278d99a7683a/resourceGroups/vmss-demo/providers/Microsoft.DBforPostgreSQL/flexibleServers/azurefailure"
                    }
                ],
                "filter": {
                    "parameters": {
                        "zones": [
                            "2",
                            "1"
                        ]
                    },
                    "type": "Simple"
                }
            },
            {
                "id": "RedisCache",
                "type": "List",
                "targets": [
                    {
                        "id": "/subscriptions/44194899-7181-423a-9dbc-278d99a7683a/resourceGroups/vmss-demo/providers/Microsoft.Cache/Redis/azurefailure",
                        "type": "ChaosTarget"
                    }
                ]
            },
            {
                "id": "AKSSelector",
                "type": "List",
                "targets": [
                    {
                        "type": "ChaosTarget",
                        "id": "/subscriptions/44194899-7181-423a-9dbc-278d99a7683a/resourceGroups/vmss-demo/providers/Microsoft.ContainerService/managedClusters/aks-azurefailure"
                    }
                ],
                "filter": {
                    "parameters": {
                        "zones": [
                            "1"
                        ],
                        "nodepool": [
                            "agentpool"
                        ]
                    },
                    "type": "Simple"
                }
            }
        ]
    },
    "name": "ShutdownAllResources",
    "apiVersion": "2025-09-22"
}